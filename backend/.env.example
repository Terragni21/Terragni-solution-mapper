# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env or share it in a zip: it holds secret keys.

# --- AI model (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
JOURNEY_GROQ_MAX_COMPLETION_TOKENS=1800
JOURNEY_GROQ_REASONING_EFFORT=low

# --- Web server ---
PORT=5000
FLASK_DEBUG=false

# --- Oracle knowledge base ---
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_HOST=your_oracle_host_name
ORACLE_HOST_IP=fallback_ip_if_the_host_name_does_not_resolve
ORACLE_PORT=1521
ORACLE_SID=your_oracle_sid

# --- Ollama embeddings (meaning search) ---
# Use 127.0.0.1 rather than localhost on Windows (localhost is slower).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_BATCH_SIZE=16

# --- Performance ---
# How long (seconds) the 803 document embeddings stay in memory.
EMBEDDING_CACHE_SECONDS=900

# --- Legacy keyword retriever (older /api/query fallback) ---
TOP_K_CHUNKS=10
MAX_CHUNK_CHARS=4500

# ---------- Contact form emails (optional) ----------
# Leave SMTP_HOST empty to only save leads to backend/data/leads/leads.jsonl.
# With Gmail / Google Workspace use smtp.gmail.com and an App Password;
# with Microsoft 365 use smtp.office365.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Terragni Consulting <engage@terragni.co>
LEAD_NOTIFY_TO=engage@terragni.co
