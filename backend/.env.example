# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env or share it in a zip: it holds secret keys.

# --- AI model (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
JOURNEY_GROQ_MAX_COMPLETION_TOKENS=3600
JOURNEY_GROQ_REASONING_EFFORT=low

# --- Web server ---
PORT=5000
FLASK_DEBUG=false

# --- Supabase PostgreSQL (the only database) ---
# Supabase -> Project Settings -> Database -> Connection string -> Transaction pooler.
# Host must be aws-0-<region>.pooler.supabase.com (NOT db.<project>.supabase.co).
# If the password has special characters (@ # / : ?) URL-encode them.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSLMODE=require

# --- Embeddings (meaning search) ---
# Visitor questions are embedded with FastEmbed; the stored chunk vectors for
# the same model are created with: python -m backend.scripts.reembed_chunks
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
DB_EMBEDDING_MODEL=bge-small-en-v1.5
# FASTEMBED_CACHE_DIR=backend/model_cache   (default)
EMBEDDING_CACHE_SECONDS=900
WARM_UP_ON_START=true

# --- Ollama: only for re-embedding new documents on YOUR computer ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_BATCH_SIZE=16

# --- Legacy keyword retriever ---
TOP_K_CHUNKS=10
MAX_CHUNK_CHARS=4500

# ---------- Contact form emails (optional) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Terragni Consulting <engage@terragni.co>
LEAD_NOTIFY_TO=engage@terragni.co
