# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env or share it: it holds passwords and keys.

# --- AI model (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
JOURNEY_GROQ_MAX_COMPLETION_TOKENS=3600
JOURNEY_GROQ_REASONING_EFFORT=low

# --- Web server (local) ---
PORT=5000
FLASK_DEBUG=false

# --- Local Oracle database (the only database) ---
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_HOST=localhost
ORACLE_HOST_IP=
ORACLE_PORT=1521
ORACLE_SID=your_oracle_sid
# Use this instead of ORACLE_SID if your database uses a service name:
# ORACLE_SERVICE_NAME=XEPDB1
# Only for Oracle 11g or older (path to Oracle Instant Client):
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_21_13

# --- Embeddings (meaning search, runs on this computer) ---
# Must match the vectors stored in DOCUMENT_CHUNK_EMBEDDING (Ollama nomic-embed-text).
FASTEMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
DB_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_CACHE_SECONDS=900
WARM_UP_ON_START=true

# --- Ollama: only for embedding NEW documents ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_BATCH_SIZE=16

# --- Legacy keyword retriever ---
TOP_K_CHUNKS=10
MAX_CHUNK_CHARS=4500

# ---------- Contact form emails (optional) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Terragni Consulting <engage@terragni.co>
LEAD_NOTIFY_TO=engage@terragni.co
